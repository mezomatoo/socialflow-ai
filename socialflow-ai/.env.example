# ---- Uygulama ----
APP_URL=http://localhost:3000
APP_ENV=development
# Üretimde mutlaka 32+ karakter rastgele bir değer kullanın
SESSION_SECRET=dev-only-change-me-please-32-chars-min
# Sağlayıcı token'larını veritabanında şifrelemek için (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=dev-only-64-hex-chars-change-in-production-000000000000000000000

# ---- Veritabanı ----
# Prisma 7 sürücü adaptörleri: `file:` → libsql (SQLite), `postgresql://` → pg.
# Geliştirme/demo: proje köküne göreli SQLite dosyası.
DATABASE_URL="file:./prisma/dev.db"
# Testler ayrı bir dosya kullanır (npm run test:setup bunu otomatik uygular).
TEST_DATABASE_URL="file:./prisma/test.db"
# Üretim: PostgreSQL (prisma/schema.prisma içinde provider = "postgresql" yapın)
# DATABASE_URL="postgresql://user:password@localhost:5432/socialflow?schema=public"

# ---- Medya Deposu (S3 uyumlu) ----
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Yapay Zeka ----
AI_PROVIDER=deterministic      # deterministic | openai | anthropic
AI_DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- Sosyal Medya API Kimlik Bilgileri (Phase 2) ----
DEMO_MODE=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Faz 5: Gelen Kutusu ----
# Şema yükseltmesinden sonra kullanılabilir. Kapatmak için false.
FF_UNIFIED_INBOX=true
# Henüz tamamlanmamış sağlayıcı/ürün yetenekleri varsayılan kapalıdır.
FF_DIRECT_MESSAGES=false
FF_SOCIAL_LISTENING=false
FF_REPUTATION_MONITORING=false
FF_REVIEW_MANAGEMENT=false
FF_SOCIAL_CRM=false
FF_LEAD_MANAGEMENT=false
FF_AGENCY_MANAGEMENT=false
FF_CLIENT_PORTAL=false
FF_WHITE_LABEL=false
FF_PUBLIC_API=false
FF_OUTGOING_WEBHOOKS=false
FF_SUBSCRIPTIONS=false
FF_ENTERPRISE_SSO=false

# ---- Entegrasyon: 474 + 3eb + 0d6 birleşimi ----
# AI sağlayıcı istek zaman aşımı (ms)
AI_TIMEOUT_MS=20000
# Önizleme/demo otomatik girişini kapatmak için false yapın (üretimde etkisiz)
PREVIEW_AUTOLOGIN=
# Önizleme otomatik girişinde kullanılacak demo kullanıcı e-postası
PREVIEW_DEMO_EMAIL=demo@socialflow.ai
# Gömülü kuyruk worker'ını dev/önizlemede kapatmak için false
QUEUE_WORKER_ENABLED=
