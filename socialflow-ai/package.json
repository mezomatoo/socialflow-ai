{
  "name": "socialflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SocialFlow AI — merkezi sosyal medya içerik üretimi, uyarlama, planlama ve yayınlama platformu",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:setup": "DATABASE_URL=\"file:./test.db\" prisma db push --force-reset --skip-generate && DATABASE_URL=\"file:./test.db\" tsx prisma/seed.ts",
    "test": "DATABASE_URL=\"file:./test.db\" tsx --test tests/critical-path.test.ts tests/partial-failure.test.ts tests/brandkit.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
