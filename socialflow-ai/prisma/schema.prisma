// =============================================================================
//  SocialFlow AI — Prisma Schema
// =============================================================================
//  Demo/geliştirme için SQLite, üretim için PostgreSQL hedeflenir.
//  SQLite enum desteklemediğinden tüm enum alanlar String olarak tutulur ve
//  tip güvenliği `src/lib/types/enums.ts` içindeki TS union'ları ile sağlanır.
//  PostgreSQL'e geçiş: datasource provider="postgresql" + aşağıdaki `PG:`
//  yorumlarında belirtilen alanları `enum` / `Bytes` / `Json` tiplerine çevirin.
//
//  Temel veri modeli:
//    Content (1) ──< PlatformContent (N)
//  Yani her sosyal ağ için yeni bir kampanya kopyalanmaz; tek bir "master"
//  içerikten platform bazlı çocuk kayıtlar türetilir.
// =============================================================================

generator client {
  // Prisma 7 üretken istemci (Rust'suz): sorgu derleyicisi WASM + sürücü adaptörü.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Bağlantı adresi Prisma 7'de burada değil `prisma.config.ts` içinde tutulur
  // (CLI komutları için) ve uygulama `src/lib/prisma.ts` içindeki sürücü
  // adaptörüyle bağlanır. PostgreSQL'e geçiş: provider = "postgresql" yapın,
  // DATABASE_URL'i `postgresql://...` olarak verin; adaptör otomatik seçilir.
  provider = "sqlite" // PG: "postgresql"
}

// -----------------------------------------------------------------------------
// Kimlik, çoklu kiracılık (multi-tenancy) ve yetkilendirme
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  email        String    @unique
  passwordHash String // scrypt (bkz. src/lib/crypto.ts) — asla düz metin
  name         String
  avatarUrl    String?
  role         String    @default("OWNER") // Role — üyelik yoksa geriye dönük varsayılan
  // Durum: ACTIVE | INVITED | SUSPENDED | DELETED (soft delete/arşiv stratejisi §87)
  status       String    @default("ACTIVE")
  emailVerifiedAt DateTime?
  locale       String    @default("tr-TR")
  timezone     String    @default("Europe/Istanbul")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships    WorkspaceMember[]
  passwordResets PasswordResetToken[]
  createdContent Content[]      @relation("ContentCreator")
  approvals      Content[]      @relation("ContentApprover")
  notifications  Notification[]
  auditLogs      AuditLog[]
  sessions       Session[]

  @@index([workspaceId])
  inboxAssignments ConversationAssignment[]
  ownedLeads Lead[]
  @@unique([workspaceId, id])

}

// Sunucu taraflı oturumlar. Tarayıcıda yalnızca HttpOnly+SameSite=Lax çerez
// içinde opak bir oturum kimliği tutulur; token'lar asla localStorage'a yazılmaz.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // oturum çerezi değerinin SHA-256'sı
  csrfToken String // form/istek CSRF doğrulaması
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("PRO") // FREE | PRO | AGENCY | ENTERPRISE
  demoMode  Boolean  @default(true) // true => gerçek sosyal paylaşım yapılmaz
  timezone  String   @default("Europe/Istanbul")
  locale    String   @default("tr-TR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  members          WorkspaceMember[]
  brands           Brand[]
  socialAccounts   SocialAccount[]
  mediaAssets      MediaAsset[]
  contents         Content[]
  platformRules    PlatformRule[]
  hashtagSets      HashtagSet[]
  hashtagEntries   HashtagEntry[]
  savedMentions    SavedMention[]
  campaigns        Campaign[]
  notifications    Notification[]
  analytics        AnalyticsSnapshot[]
  auditLogs        AuditLog[]
  aiGenerations    AiGeneration[]
  jobs             Job[]
  appSettings      AppSettings?
  integrationState ProviderIntegration[]

  @@index([slug])
  adAccounts AdAccount[]
  products Product[]
  contacts Contact[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries    WebhookDelivery[]
}

// Uygulama markası (ad, logo, renkler) — Admin Ayarları'ndan düzenlenebilir.
model AppSettings {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  appName         String   @default("SocialFlow AI")
  logoUrl         String?
  logoMark        String   @default("SF")
  primaryColor    String   @default("#6D28D9")
  secondaryColor  String   @default("#0EA5E9")
  accentColor     String   @default("#F59E0B")
  radius          String   @default("14px")
  fontFamily      String   @default("Inter")
  defaultLanguage String   @default("tr")
  defaultTimezone String   @default("Europe/Istanbul")
  demoBanner      Boolean  @default(true)
  aiProvider      String   @default("deterministic")
  aiModel         String?
  aiTemperature   Float    @default(0.7)
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Marka profilleri ve marka sesi
// -----------------------------------------------------------------------------

model Brand {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  slug             String
  logoUrl          String?
  primaryColor     String   @default("#6D28D9")
  secondaryColor   String   @default("#0EA5E9")
  fontStyle        String   @default("Inter")
  website          String?
  defaultCta       String?
  description      String?
  targetAudience   String?
  defaultStyle     String   @default("PROFESSIONAL") // ContentStyle
  defaultHashtags  String   @default("") // boşlukla ayrılmış
  requiredHashtags String   @default("")
  bannedHashtags   String   @default("")
  defaultMentions  String   @default("")
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  voice          BrandVoice?
  brandKit       BrandKit?       // PHASE 4 — marka kimliğinin merkezi doğruluk kaynağı (1:1)
  socialAccounts SocialAccount[]
  contents       Content[]
  mediaAssets    MediaAsset[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  conversations SocialConversation[]
  @@unique([workspaceId, id])

  adAccounts AdAccount[]
  products Product[]
  contacts Contact[]

}

// Marka sesi: AI uyarlamasının "ton" girdisi.
model BrandVoice {
  id            String   @id @default(cuid())
  brandId       String   @unique
  tone          String   @default("profesyonel ve samimi")
  personality   String?
  audience      String?
  styleGuide    String? // PG: Json
  allowedTerms  String   @default("") // virgülle ayrılmış
  bannedTerms   String   @default("")
  mustKeepTerms String   @default("") // fiyat, ürün adı, tarih vb. — AI asla çıkarmaz
  formality     String   @default("NEUTRAL") // FORMAL | NEUTRAL | CASUAL
  emojiLevel    String   @default("MEDIUM") // NONE | LOW | MEDIUM | HIGH
  language      String   @default("tr")
  updatedAt     DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Sosyal hesaplar, OAuth token'ları ve entegrasyon durumu
// -----------------------------------------------------------------------------

model SocialAccount {
  id               String    @id @default(cuid())
  workspaceId      String
  brandId          String?
  platform         String // PlatformCode
  externalId       String? // sağlayıcının hesap/page/channel id'si
  handle           String // @kullaniciadi
  displayName      String
  avatarUrl        String?
  accountType      String    @default("PROFILE") // PROFILE | PAGE | BUSINESS | CHANNEL | GROUP
  scopes           String    @default("") // PG: Json (dizi)
  connectionStatus String    @default("ACTIVE") // ConnectionStatus
  lastValidatedAt  DateTime?
  lastError        String? // kullanıcıya gösterilecek Türkçe, anlaşılır mesaj
  demoAccount      Boolean   @default(true)
  // Faz 2: sağlayıcı yetenek bayrakları (JSON dizi) + son eşitleme zamanı.
  capabilities     String    @default("[]") // PG: Json — ProviderCapability anahtarları
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  token            SocialProviderToken?
  platformContents PlatformContent[]
  publications     Publication[]

  @@unique([workspaceId, platform, handle])
  @@index([workspaceId, platform])
  conversations SocialConversation[]
  participants SocialParticipant[]
  inboxEvents InboxEvent[]
  @@unique([workspaceId, id])

}

// Token'lar asla tarayıcıya gönderilmez; AES-256-GCM ile şifrelenerek saklanır.
model SocialProviderToken {
  id               String                @id @default(cuid())
  socialAccountId  String                @unique
  // AES-256-GCM ile şifrelenmiş, base64 metin. SQLite/PostgreSQL
  // taşınabilirliği için String; üretimde Bytes/bytea'ya çevrilebilir.
  accessTokenEnc   String
  refreshTokenEnc  String?
  tokenType        String                @default("Bearer")
  scope            String                @default("")
  expiresAt        DateTime?
  refreshExpiresAt DateTime?
  lastRefreshedAt  DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

// Çalışma alanı bazlı API entegrasyon durumu (Bağlı / Yapılandırılmadı / ...)
model ProviderIntegration {
  id             String    @id @default(cuid())
  workspaceId    String
  platform       String // PlatformCode
  status         String    @default("NOT_CONFIGURED") // IntegrationStatus
  credentialsSet Boolean   @default(false)
  apiVersion     String?
  lastCheckedAt  DateTime?
  message        String? // Türkçe açıklama
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
}

// -----------------------------------------------------------------------------
// Medya kütüphanesi
// -----------------------------------------------------------------------------

model MediaFolder {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  createdAt   DateTime @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([workspaceId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  workspaceId  String
  brandId      String?
  folderId     String?
  kind         String // IMAGE | VIDEO | LOGO | CAROUSEL_ITEM
  filename     String
  originalName String
  storageKey   String // orijinal master dosya — asla değiştirilmez
  publicUrl    String?
  mimeType     String
  format       String // jpg | png | webp | mp4 ...
  bytes        Int
  width        Int?
  height       Int?
  durationMs   Int?
  aspectRatio  Float?
  contentHash  String? // SHA-256 → aynı dosya iki kez yüklenmez
  focalPoint   String? // PG: Json { x, y, method }
  analysis     String? // PG: Json — MediaAnalysisService çıktısı
  // Türetilmiş render varyantları. Orijinal dokunulmadan korunur.
  // PG: Json → [{ platform, contentType, ratio, storageKey, width, height, bytes }]
  derivatives  String   @default("[]")
  tags         String   @default("")
  campaign     String?
  alt          String?
  status       String   @default("READY") // PENDING | PROCESSING | READY | FAILED
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  folder           MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  contentLinks     ContentMedia[]
  platformContents PlatformContent[]
  variants         MediaVariant[]

  @@unique([workspaceId, contentHash])
  @@index([workspaceId, kind])
  @@index([workspaceId, createdAt])
}

// -----------------------------------------------------------------------------
// İçerik: master kayıt + platform bazlı çocuk kayıtlar
// -----------------------------------------------------------------------------

model Content {
  id               String    @id @default(cuid())
  workspaceId      String
  brandId          String
  campaignId       String?
  title            String?
  masterCaption    String
  storyText        String? // Hikaye metni, ana açıklamadan bağımsız olabilir
  linkUrl          String?
  utm              String? // PG: Json { source, medium, campaign, content, term }
  defaultStyle     String    @default("PROFESSIONAL") // ContentStyle
  defaultCta       String?
  hashtagPlacement String    @default("INLINE") // INLINE | FIRST_COMMENT | SEPARATE
  timezone         String    @default("Europe/Istanbul")
  scheduleMode     String    @default("NOW") // NOW | SCHEDULE | DRAFT
  scheduledFor     DateTime?
  status           String    @default("DRAFT") // ContentStatus: DRAFT | PROCESSING | READY | ARCHIVED (+ yayın durumları)
  // İçeriğin kaynağı: MANUAL | AI_ASSISTED | AI_GENERATED | IMPORTED | REPURPOSED
  origin           String    @default("MANUAL")
  adaptState       String    @default("NONE") // NONE | ADAPTING | ADAPTED | PARTIAL | ERROR
  version          Int       @default(1)
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign         Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("ContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy       User?               @relation("ContentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  media            ContentMedia[]
  versions         ContentVersion[]
  aiGenerations    AiGeneration[]
  platformContents PlatformContent[]
  schedules        Schedule[]
  notifications    Notification[]
  analytics        AnalyticsSnapshot[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, brandId])
  @@index([brandId])
}

model ContentMedia {
  id        String @id @default(cuid())
  contentId String
  mediaId   String
  position  Int    @default(0)

  content Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([contentId, mediaId])
  @@index([contentId])
}

// Sürüm geçmişi: orijinal → AI uyarlaması → kullanıcı düzenlemesi
model ContentVersion {
  id          String   @id @default(cuid())
  contentId   String
  version     Int
  kind        String   @default("MANUAL") // ORIGINAL | AI_ADAPTED | MANUAL | RESTORED
  note        String?
  // PG: Json — { masterCaption, storyText, style, platformContents: {...} }
  payload     String   @default("{}")
  createdById String?
  createdAt   DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([contentId])
}

// *** KRİTİK *** Her hedef (platform + içerik türü) için bağımsız çocuk kayıt.
model PlatformContent {
  id              String  @id @default(cuid())
  contentId       String
  socialAccountId String?
  platform        String // PlatformCode
  contentType     String // ContentType: FEED | STORY | REEL | SHORTS | POST | PIN | VIDEO
  key             String // "instagram:FEED" — içerik başına benzersiz
  enabled         Boolean @default(true)

  caption          String  @default("")
  captionSource    String  @default("PENDING") // PENDING | AI | MANUAL | ORIGINAL
  hashtags         String  @default("")
  hashtagPlacement String  @default("INLINE")
  cta              String?
  linkUrl          String?
  firstComment     String?

  // Medya render özellikleri (orijinal medya değiştirilmez, varyant üretilir)
  mediaAssetId String?
  aspectRatio  String? // "1:1" | "4:5" | "9:16" | "16:9"
  targetWidth  Int?
  targetHeight Int?
  focalPoint   String? // PG: Json { x, y }
  cropMode     String  @default("SMART") // SMART | MANUAL | FIT | AI_EXTEND
  manualOffset String? // PG: Json { x, y } — elle kaydırma
  edits        String  @default("{}") // PG: Json — rotate/zoom/brightness/... + katmanlar
  renderedKey  String? // üretilen varyantın storage anahtarı
  renderedUrl  String?
  safeAreaOk   Boolean @default(true)

  charLimit Int @default(2200)
  charUsed  Int @default(0)
  // Üretimde kullanılan PlatformRule sürümü (kural değişse bile kayıt korunur).
  platformRuleVersion Int?

  status         String    @default("DRAFT") // PublishStatus
  scheduledFor   DateTime?
  publishedAt    DateTime?
  lastError      String? // Türkçe, anlaşılır hata
  lastErrorCode  String? // sağlayıcının ham hata kodu (log için)
  retryCount     Int       @default(0)
  externalPostId String?
  permalink      String?
  updatedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())

  content       Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  mediaAsset    MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  schedule      Schedule?
  publications  Publication[]
  analytics     AnalyticsSnapshot[]

  @@unique([contentId, key])
  @@index([contentId])
  @@index([status, scheduledFor])
  @@index([scheduledFor])
  @@index([enabled, scheduledFor])
  @@index([socialAccountId])
  @@index([mediaAssetId])
}

// -----------------------------------------------------------------------------
// Planlama, yayınlama ve idempotent denemeler
// -----------------------------------------------------------------------------

model Schedule {
  id                String   @id @default(cuid())
  contentId         String
  platformContentId String   @unique
  scheduledFor      DateTime
  timezone          String   @default("Europe/Istanbul")
  status            String   @default("PENDING") // PENDING | QUEUED | PROCESSING | DONE | FAILED | CANCELLED
  jobId             String?
  aiSuggested       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  content         Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platformContent PlatformContent @relation(fields: [platformContentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([scheduledFor, status])
  @@index([contentId])
}

model Publication {
  id                String    @id @default(cuid())
  platformContentId String
  contentId         String
  // Faz 2: yayın hangi sosyal hesaba yapıldı (hesap silinse bile kayıt korunur).
  socialAccountId   String?
  // İdempotency anahtarı: retry'larda çift gönderim oluşmaz.
  idempotencyKey    String    @unique
  status            String    @default("PENDING") // PublicationStatus
  providerPostId    String?
  permalink         String?
  publishedAt       DateTime?
  demoMode          Boolean   @default(true)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  lastError         String?
  // Faz 2: normalleştirilmiş sağlayıcı hata kodu (AUTH_REQUIRED, RATE_LIMITED, ...)
  normalizedErrorCode String?
  // Faz 2: sağlayıcı asenkron işliyorsa (video) PROCESSING takibi
  providerStatusCheckedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  platformContent PlatformContent      @relation(fields: [platformContentId], references: [id], onDelete: Cascade)
  attemptsLog     PublicationAttempt[]
  socialAccount   SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  snapshot        PublicationSnapshot?

  @@index([contentId])
  @@index([status])
  @@index([socialAccountId])
}

// Faz 2 — yayın anındaki değişmez anlık görüntü (§40):
// caption/hashtag/CTA/medya varyantı/içerik sürümü/kural sürümü/hesap/provider.
// Sonradan içerik düzenlense bile yayınlanan neyse odur; denetim bu kayıttan yapılır.
model PublicationSnapshot {
  id                  String   @id @default(cuid())
  publicationId       String   @unique
  provider            String
  contentType         String
  caption             String   @default("")
  hashtags            String   @default("")
  cta                 String?
  firstComment        String?
  mediaKind           String? // IMAGE | VIDEO
  mediaStorageKey     String?
  mediaUrl            String?
  mediaWidth          Int?
  mediaHeight         Int?
  contentVersion      Int      @default(1)
  platformRuleVersion Int?
  accountHandle       String?
  accountExternalId   String?
  createdAt           DateTime @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
}

model PublicationAttempt {
  id              String   @id @default(cuid())
  publicationId   String
  attempt         Int
  ok              Boolean
  httpStatus      Int?
  providerCode    String? // ör. "OAuthException 190"
  providerMessage String?
  friendlyMessage String? // Türkçe, kullanıcıya gösterilen
  // Faz 2: normalleştirilmiş kod (AUTH_REQUIRED | TOKEN_EXPIRED | PERMISSION_DENIED |
  // MEDIA_INVALID | CAPTION_INVALID | RATE_LIMITED | ACCOUNT_RESTRICTED |
  // PROVIDER_TEMPORARY_ERROR | UNKNOWN_PROVIDER_ERROR)
  normalizedCode  String?
  retryable       Boolean?
  actionLabel     String? // ör. "Hesabı Yeniden Bağla"
  actionRoute     String?
  durationMs      Int?
  createdAt       DateTime @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
}

// -----------------------------------------------------------------------------
// Platform kural motoru — sınırlar koda gömülü DEĞİL, veritabanında tutulur
// -----------------------------------------------------------------------------

model PlatformRule {
  id                       String   @id @default(cuid())
  workspaceId              String
  platform                 String // PlatformCode
  contentType              String // ContentType
  label                    String // "Instagram Gönderisi"
  maxCaptionLength         Int
  recommendedCaptionLength Int
  minCaptionLength         Int      @default(0)
  supportedAspectRatios    String   @default("[]") // PG: Json ["1:1","4:5"]
  recommendedAspectRatio   String
  minWidth                 Int
  minHeight                Int
  maxWidth                 Int      @default(4096)
  maxHeight                Int      @default(4096)
  // Boyutlar KB olarak saklanır (256 GB gibi büyük değerler INT32 sınırını
  // aşmasın diye). Kural motoru bunları bayta çevirir.
  maxFileSizeKb            Int
  maxVideoFileSizeKb       Int?
  supportedMimeTypes       String   @default("[]") // PG: Json
  supportedImageFormats    String   @default("[]")
  supportedVideoFormats    String   @default("[]")
  maxVideoDuration         Int? // saniye
  minVideoDuration         Int?
  maxMediaCount            Int      @default(1)
  maxHashtags              Int      @default(0)
  recommendedHashtags      Int      @default(0)
  hashtagRecommendation    String   @default("[]") // PG: Json — örnek/önerilen etiketler
  supportsLinks            Boolean  @default(false)
  clickableLinks           Boolean  @default(false)
  supportsStories          Boolean  @default(false)
  supportsCarousel         Boolean  @default(false)
  supportsReels            Boolean  @default(false)
  supportsScheduling       Boolean  @default(true)
  supportsFirstComment     Boolean  @default(false)
  supportsLocation         Boolean  @default(false)
  supportsMentions         Boolean  @default(true)
  supportsAltText          Boolean  @default(false)
  supportsThreads          Boolean  @default(false)
  safeArea                 String? // PG: Json { top, bottom, left, right } (oransal)
  restrictions             String   @default("[]") // PG: Json — Türkçe kısıt açıklamaları
  apiVersion               String   @default("v1")
  capabilities             String   @default("[]") // PG: Json
  source                   String   @default("BUILTIN") // BUILTIN | SYNCED | MANUAL
  active                   Boolean  @default(true)
  // Kural sürümü: içerik/PlatformContent hangi sürümle üretildiğini saklar.
  version                  Int      @default(1)
  lastUpdatedAt            DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  PlatformRuleVersion[]

  @@unique([workspaceId, platform, contentType])
  @@index([workspaceId, platform])
}

// -----------------------------------------------------------------------------
// Hashtag motoru, mention'lar, kampanyalar
// -----------------------------------------------------------------------------

model HashtagSet {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  group       String   @default("GENERAL") // HashtagGroup
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   HashtagEntry[]

  @@index([workspaceId])
}

model HashtagEntry {
  id          String   @id @default(cuid())
  setId       String?
  workspaceId String
  tag         String // # işareti olmadan
  group       String   @default("GENERAL")
  language    String   @default("tr")
  blocked     Boolean  @default(false) // yasaklı/güvensiz etiket
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())

  set       HashtagSet? @relation(fields: [setId], references: [id], onDelete: Cascade)
  Workspace Workspace   @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, tag])
  @@index([workspaceId, group])
}

model SavedMention {
  id          String   @id @default(cuid())
  workspaceId String
  handle      String // @brand
  platform    String? // null => tüm platformlar
  label       String?
  required    Boolean  @default(false) // AI kısaltırken asla çıkarmaz
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, handle, platform])
}

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  code        String
  startDate   DateTime?
  endDate     DateTime?
  budget      Float? // ₺ TRY
  currency    String    @default("TRY")
  notes       String?
  createdAt   DateTime  @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents  Content[]
  analytics AnalyticsSnapshot[]

  leads Lead[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
}

// -----------------------------------------------------------------------------
// Bildirimler, analizler, denetim kaydı, kuyruk
// -----------------------------------------------------------------------------

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  contentId   String?
  type        String    @default("INFO") // NotificationType
  title       String
  message     String
  severity    String    @default("INFO") // INFO | SUCCESS | WARNING | ERROR
  readAt      DateTime?
  actionLabel String?
  actionRoute String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content?  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, readAt])
  @@index([userId, createdAt])
}

model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  workspaceId       String
  platformContentId String?
  contentId         String?
  campaignId        String?
  brandId           String?
  platform          String
  accountHandle     String?
  date              DateTime // gün bazlı
  impressions       Int      @default(0)
  reach             Int      @default(0)
  likes             Int      @default(0)
  comments          Int      @default(0)
  shares            Int      @default(0)
  saves             Int      @default(0)
  clicks            Int      @default(0)
  videoViews        Int      @default(0)
  engagementRate    Float    @default(0)
  followerDelta     Int      @default(0)
  source            String   @default("DEMO") // API | DEMO
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformContent PlatformContent? @relation(fields: [platformContentId], references: [id], onDelete: Cascade)
  content         Content?         @relation(fields: [contentId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, date])
  @@index([platformContentId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String // ör. "content.publish", "account.connect"
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    String? // PG: Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

// Kalıcı (durable) arka plan iş kuyruğu — veritabanı destekli.
// Üretimde BullMQ/Redis veya SQS'e taşınabilir; arayüz aynı kalır.
model Job {
  id             String    @id @default(cuid())
  workspaceId    String?
  type           String // PublishContentJob | MediaProcessingJob | AnalyticsSyncJob | TokenRefreshJob
  payload        String    @default("{}") // PG: Json
  status         String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELLED
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lockedBy       String?
  lockedAt       DateTime?
  lastError      String?
  result         String? // PG: Json
  // Aynı işin iki kez kuyruğa girmesini engeller (idempotency).
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([type, status])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

// OAuth "state" doğrulaması (CSRF koruması). Kısa ömürlü, tek kullanımlık.
model OAuthState {
  socialAccountId String?
  redirectUri String?
  accountUpdatedAt DateTime?
  id           String    @id @default(cuid())
  state        String    @unique
  platform     String
  userId       String?
  workspaceId  String?
  codeVerifier String? // PKCE
  redirect     String?
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

// =============================================================================
//  PHASE 4 — BRAND KIT (additive: mevcut Brand/BrandVoice/MediaAsset KORUNUR)
// =============================================================================
//  BrandKit, Brand'in 1:1 genişlemesidir ve marka kimliğinin MERKEZİ doğruluk
//  kaynağıdır (source of truth). Tüm AI/kreatif modülleri buradan beslenir.
//  - Çoklu-marka izolasyonu (§134): her kayıt workspaceId + brandId taşır.
//  - Onay deseni (§44): DRAFT | PENDING_APPROVAL | APPROVED | ARCHIVED.
//  - Sürümleme (§45/§46): BrandKitVersion tüm kitin JSON anlık görüntüsünü tutar.
//  - SQLite uyumu: enum'lar String, diziler/nesneler JSON String olarak saklanır.
//  - Medya tekrar kullanımı: logo/varlık/referans kayıtları storageKey + opsiyonel
//    mediaAssetId ile MEVCUT medya sistemine bağlanır (yeni medya sistemi YOK).

model BrandKit {
  id          String @id @default(cuid())
  workspaceId String
  brandId     String @unique

  // --- Durum / sürüm / kilit (§40-§42, §45) ---
  status            String  @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  currentVersion    Int     @default(1)
  completenessScore Int     @default(0) // 0-100 otomatik hesaplanır (§40)
  lockMode          String  @default("OFF") // OFF | STANDARD | STRICT (§41)
  strictMode        Boolean @default(false) // (§42) lockMode=STRICT ile hizalı
  consistencyGate   String  @default("WARNING") // OFF | WARNING | REQUIRE_APPROVAL | BLOCK (§55)
  learnFromApproved Boolean @default(false) // (§51) varsayılan KAPALI

  // --- Temel bilgiler (§5) — Brand.name/website/description'ı GENİŞLETİR ---
  shortName          String?
  legalName          String?
  mainSlogan         String?
  subSlogan          String?
  longDescription    String?
  shortDescription   String?
  industry           String?
  subIndustry        String?
  foundedYear        Int?
  country            String?
  mainMarket         String?
  targetMarkets      String  @default("[]") // JSON dizi
  mainLanguage       String  @default("tr")
  supportedLanguages String  @default("[\"tr\"]") // JSON dizi

  // --- İletişim (§6) — AI asla uydurmaz, yalnızca buradan okur ---
  phone        String?
  email        String?
  whatsapp     String?
  address      String?
  supportLine  String?
  workingHours String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions      BrandKitVersion[]
  logos         BrandLogo[]
  colors        BrandColor[]
  typography    BrandTypography[]
  messages      BrandMessage[]
  ctas          BrandCTA[]
  hashtags      BrandHashtag[]
  mentions      BrandMention[]
  visualRules   BrandVisualRule[]
  platformRules BrandPlatformRule[]
  legalRules    BrandLegalRule[]
  assets        BrandAsset[]
  references    BrandReference[]
  memories      BrandMemory[]

  @@index([workspaceId])
}

// Sürüm geçmişi (§45/§46): her onayda kitin tam JSON anlık görüntüsü.
model BrandKitVersion {
  id         String @id @default(cuid())
  workspaceId String
  brandId    String
  brandKitId String
  version    Int
  label      String? // ör. "v1.2"
  note       String?
  snapshot   String  @default("{}") // kitin tamamının JSON anlık görüntüsü
  createdBy  String?
  createdAt  DateTime @default(now())

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@unique([brandKitId, version])
  @@index([workspaceId])
  @@index([brandId])
}

// Logo (§7-§10): kullanım tipi başına ayrı kayıt; kötüye-kullanım kuralları JSON.
model BrandLogo {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  usageType   String  @default("PRIMARY") // PRIMARY|HORIZONTAL|VERTICAL|ICON|LIGHT_BG|DARK_BG|MONOCHROME|WATERMARK|FAVICON|APP_ICON
  name        String?
  storageKey  String? // mevcut storage() sürücüsünde
  fileUrl     String?
  mediaAssetId String? // opsiyonel çapraz referans (yeni medya sistemi değil)
  format      String?
  width       Int?
  height      Int?
  bytesKb     Int?
  transparentBg Boolean @default(false)
  isPrimary   Boolean @default(false)
  // Kullanım kuralları (§8)
  minWidth    Int?
  minHeight   Int?
  minSafeSpace String? // ör. "1x"
  preferredPosition String?
  allowedBackgrounds String @default("[]") // JSON
  disallowedBackgrounds String @default("[]") // JSON
  maxRotation Int     @default(0)
  safeArea    String  @default("{}") // JSON {top,right,bottom,left}
  misuseRules String  @default("[]") // JSON dizi (§10)
  approvalStatus String @default("DRAFT") // DRAFT|PENDING_APPROVAL|APPROVED|ARCHIVED
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Renk (§11-§15): tam palet + pantone/cmyk; yasaklı renkler prohibited ile.
model BrandColor {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  name        String
  hex         String
  rgb         String? // "255,255,255"
  cmyk        String? // "0,0,0,0"
  pantone     String?
  category    String  @default("PRIMARY") // PRIMARY|SECONDARY|ACCENT|BACKGROUND|TEXT|NEUTRAL|SUPPORT|CAMPAIGN
  usage       String? // kullanım açıklaması
  priority    Int     @default(0)
  prohibited  Boolean @default(false) // (§14) kullanılmaması gereken renkler
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Tipografi (§16-§18): rol başına font + lisans bilgisi.
model BrandTypography {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  role        String  @default("BODY") // HEADING|SUBHEADING|BODY|CTA|ACCENT
  fontFamily  String
  fontWeight  String? // "400","700","Bold"
  fontSizeRec String? // önerilen punto aralığı
  lineHeight  String?
  letterSpacing String?
  textCase    String? // none|uppercase|lowercase|capitalize
  usage       String?
  licenseName String?
  licenseProvider String?
  licenseNote String?
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Slogan & mesajlar (§23-§24).
model BrandMessage {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  type        String  @default("MAIN_SLOGAN") // MAIN_SLOGAN|SUB_SLOGAN|CAMPAIGN_SLOGAN|PRODUCT_SLOGAN|SHORT_MESSAGE|BRAND_PROMISE|USP|VALUE_PROPOSITION
  text        String
  language    String  @default("tr")
  isPrimary   Boolean @default(false)
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// CTA (§25-§26): genel veya platform/kampanya bazlı; tercih edilen/yasaklı.
model BrandCTA {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  text        String
  platform    String? // null = genel; değilse PlatformCode
  category    String  @default("PREFERRED") // PREFERRED|FORBIDDEN|CAMPAIGN
  campaignId  String?
  isPreferred Boolean @default(false)
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Hashtag (§27): marka kiti kapsamı (workspace HashtagSet'i TAMAMLAR).
model BrandHashtag {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  tag         String // "#" olmadan
  category    String  @default("DEFAULT") // DEFAULT|REQUIRED|CAMPAIGN|PRODUCT|LOCATION|COMMUNITY|BANNED
  campaignId  String?
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Mention (§28): marka kiti kapsamı (workspace SavedMention'ı TAMAMLAR).
model BrandMention {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  handle      String // "@..."
  platform    String?
  type        String  @default("OFFICIAL") // OFFICIAL|PARTNER|FOUNDER|CAMPAIGN_PARTNER|LOCATION|OTHER
  label       String?
  required    Boolean @default(false)
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Görsel stil kuralları (§29-§33): esnek kategori + JSON config.
model BrandVisualRule {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  category    String  @default("PHOTOGRAPHY") // PHOTOGRAPHY|LIGHTING|BACKGROUND|COMPOSITION|DEPTH|COLOR_GRADING|PRODUCT_PLACEMENT|HUMAN_PRESENCE|MODEL|LIFESTYLE|TEXTURE|MOOD|ICON_STYLE|SHAPE_STYLE|PRODUCT_VISUAL
  title       String
  description String?
  recommendedKeywords String @default("[]") // JSON dizi
  avoidKeywords String @default("[]") // JSON dizi
  config      String  @default("{}") // JSON (kategoriye özel ayarlar)
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Sosyal medya / platform kuralları (§34): platform başına ton/CTA/emoji override.
model BrandPlatformRule {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  platform    String // PlatformCode
  contentType String? // null = tüm tipler
  guidance    String? // serbest metin yönerge
  toneOverride String?
  ctaOverride  String?
  emojiLevel   String? // none|low|medium|high
  config       String  @default("{}") // JSON
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@unique([brandKitId, platform, contentType])
  @@index([workspaceId])
  @@index([brandId])
}

// Yasal + kampanya biçimlendirme kuralları (§35-§36).
model BrandLegalRule {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  category    String  @default("LEGAL_INFO") // LEGAL_INFO|CAMPAIGN_RULE
  key         String // PRICE_FORMAT|DISCOUNT_FORMAT|DATE_FORMAT|COUPON_FORMAT|MANDATORY_DISCLAIMER|REQUIRED_LEGAL_LINE|KVKK_URL|PRIVACY_URL|TERMS_URL|RETURN_POLICY_URL|REGISTERED_NAME|LEGAL_NOTICE|PROMOTION_RULE ...
  value       String
  required    Boolean @default(false)
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@unique([brandKitId, category, key])
  @@index([workspaceId])
  @@index([brandId])
}

// Marka dosyaları / varlıklar (§37): storage() üzerinde, opsiyonel mediaAssetId.
model BrandAsset {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  type        String  @default("OTHER") // LOGO|PRODUCT_IMAGE|FOUNDER_IMAGE|STORE_IMAGE|OFFICE_IMAGE|BACKGROUND|ICON|ILLUSTRATION|CAMPAIGN_IMAGE|VIDEO_INTRO|VIDEO_OUTRO|JINGLE|AUDIO|PDF_GUIDELINE|OTHER
  name        String
  storageKey  String?
  fileUrl     String?
  mediaAssetId String?
  mimeType    String?
  format      String?
  bytesKb     Int?
  width       Int?
  height      Int?
  tags        String  @default("[]") // JSON dizi
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Referanslar (§52): beğenilen / kaçınılacak tasarımlar.
model BrandReference {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  kind        String  @default("LIKED") // LIKED | AVOID
  title       String?
  note        String?
  storageKey  String?
  fileUrl     String?
  externalUrl String?
  mediaAssetId String?
  approvalStatus String @default("DRAFT")
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// Marka hafızası (§50-§51): onaylı içerikten öğrenilen tercihler (varsayılan KAPALI).
model BrandMemory {
  id          String  @id @default(cuid())
  workspaceId String
  brandId     String
  brandKitId  String
  kind        String  @default("STYLE_INSIGHT") // STYLE_INSIGHT|APPROVED_PATTERN|PREFERENCE
  source      String  @default("BRAND_KIT") // BRAND_KIT|APPROVED_CONTENT|APPROVED_CAMPAIGN|APPROVED_CREATIVE|TEMPLATE
  sourceId    String? // kaynak kaydın id'si (izlenebilirlik)
  summary     String
  data        String  @default("{}") // JSON
  embedding   String? // JSON dizi (semantik arama STEP 29'da doldurulur)
  enabled     Boolean @default(true)
  approvalStatus String @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId])
  @@index([workspaceId])
  @@index([brandId])
}

// -----------------------------------------------------------------------------
// PHASE 1 — Çalışma alanı üyeliği (RBAC temeli)
// -----------------------------------------------------------------------------
// İş verileri doğrudan kullanıcıya DEĞİL, çalışma alanına bağlıdır. Kullanıcı ile
// çalışma alanı arasındaki ilişki bu tabloda tutulur; ekipler, acenteler, müşteri
// hesapları ve ileriki fazlardaki roller (RBAC) bu yapı üzerine kurulur.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("OWNER") // OWNER | ADMIN | EDITOR | APPROVER | VIEWER | ANALYST
  status      String    @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

// -----------------------------------------------------------------------------
// PHASE 1 — Şifre sıfırlama
// -----------------------------------------------------------------------------
// Yalnızca token'ın SHA-256 özeti saklanır; ham token e-postayla gönderilir.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// PHASE 1 — Medya varyantı
// -----------------------------------------------------------------------------
// Orijinal yükleme ASLA değiştirilmez. Her platform/içerik türü için üretilen
// kırpılmış/ölçeklenmiş türev burada ayrı bir kayıt olarak tutulur.
model MediaVariant {
  id           String   @id @default(cuid())
  mediaAssetId String
  workspaceId  String
  // NULL yerine boş dize: SQLite'ta NULL değerler benzersizlik kısıtında
  // birbirinden farklı sayılır; tekilleştirme için "" kullanılır.
  platform     String   @default("") // PlatformCode (genel varyantlar için "")
  contentType  String   @default("") // ContentType
  kind         String   @default("CROP") // CROP | SCALE | THUMBNAIL | COVER | VIDEO_POSTER
  aspectRatio  String   @default("") // "1:1" | "4:5" | "9:16" | "16:9"
  storageKey   String
  publicUrl    String?
  mimeType     String
  width        Int?
  height       Int?
  durationMs   Int?
  bytes        Int?
  focalPoint   String? // PG: Json { x, y }
  cropMode     String   @default("SMART") // SMART | MANUAL | FIT
  // Yapay zekâ DEĞİL, deterministik/akıllı kırpma bilgisi (şeffaflık için).
  processingMethod String @default("DETERMINISTIC") // DETERMINISTIC | USER_FOCAL_POINT | AI_SALIENCY (ileride)
  processingStatus String @default("READY") // PENDING | PROCESSING | READY | FAILED (yüklendi/işleniyor/hazır/başarısız)
  processingMetadata String @default("{}") // PG: Json — kırpma kutusu, kaynak boyut, hata mesajı
  checksum     String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, platform, contentType, aspectRatio])
  @@index([mediaAssetId])
  @@index([workspaceId, platform])
  @@index([workspaceId, createdAt])
  @@index([processingStatus])
}

// -----------------------------------------------------------------------------
// PHASE 1 — Yapay zekâ üretim kaydı (denetim + tekrarlanabilirlik)
// -----------------------------------------------------------------------------
// Gizli anahtar/token ASLA saklanmaz. Yalnızca sağlayıcı adı, model, istem
// özeti (hash) ve sonuç meta verisi tutulur.
model AiGeneration {
  id          String   @id @default(cuid())
  workspaceId String
  contentId   String?
  brandId     String?
  userId      String?
  // ADAPT_CAPTION | GENERATE_CAPTION | HASHTAGS | SPELLCHECK | VARIANT_COPY ...
  type        String
  provider    String // deterministic | openai | anthropic
  model       String?
  platform    String?
  contentType String?
  inputHash   String? // istem (prompt) özeti — kişisel veri saklanmaz
  status      String   @default("SUCCESS") // SUCCESS | FAILED | SKIPPED
  errorCode   String?
  tokensIn    Int?
  tokensOut   Int?
  durationMs  Int?
  metadata    String   @default("{}") // PG: Json — uyarılar, korunan gerçekler, sürüm
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content   Content?  @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([contentId])
  @@index([type, status])
}

// -----------------------------------------------------------------------------
// PHASE 1 — Platform kural sürümleri
// -----------------------------------------------------------------------------
// Kurallar zamanla değişir. Güncelleme sırasında eski tanım SİLİNMEZ; yeni bir
// sürüm satırı olarak saklanır. Üretilmiş içerikler kullandıkları sürümü
// (`PlatformContent.platformRuleVersion`) referans alır.
model PlatformRuleVersion {
  id            String   @id @default(cuid())
  platformRuleId String
  workspaceId   String
  platform      String
  contentType   String
  version       Int
  label         String
  // Kuralın tam anlık görüntüsü (PG: Json)
  snapshot      String   @default("{}")
  changeNote    String?
  changedById   String?
  createdAt     DateTime @default(now())

  rule PlatformRule @relation(fields: [platformRuleId], references: [id], onDelete: Cascade)

  @@unique([platformRuleId, version])
  @@index([workspaceId, platform, contentType])
}

// PHASE 5 — additive inbox foundation. No publishing/token tables replaced.
model SocialParticipant {
  id                    String @id @default(cuid())
  workspaceId           String
  socialAccountId       String
  providerParticipantId String
  displayName           String
  firstSeenAt           DateTime @default(now())
  lastSeenAt            DateTime @default(now())
  account SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Restrict)
  conversations SocialConversation[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, socialAccountId, providerParticipantId])
}

model SocialConversation {
  id                     String @id @default(cuid())
  workspaceId            String
  brandId                String
  socialAccountId        String
  participantId          String
  provider               String
  providerConversationId String
  source                 String @default("MANUAL")
  type                   String
  status                 String @default("NEW")
  priority               String @default("NORMAL")
  assignedTo             String?
  version                Int @default(1)
  firstMessageAt         DateTime @default(now())
  lastMessageAt          DateTime @default(now())
  resolvedAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  brand Brand @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  account SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Restrict)
  participant SocialParticipant @relation(fields: [workspaceId, participantId], references: [workspaceId, id], onDelete: Restrict)
  messages SocialMessage[]
  assignments ConversationAssignment[]
  contactLink ContactConversationLink?
  tags ConversationTag[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, socialAccountId, providerConversationId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedTo])
}

model SocialMessage {
  id                String @id @default(cuid())
  workspaceId       String
  conversationId    String
  providerMessageId String
  direction         String // INBOUND | OUTBOUND | INTERNAL; INTERNAL never transported
  messageType       String @default("TEXT")
  sender            String
  text              String
  sentAt            DateTime
  receivedAt        DateTime @default(now())
  isRead            Boolean @default(false)
  createdAt         DateTime @default(now())
  conversation SocialConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([conversationId, providerMessageId])
  @@index([workspaceId, conversationId, sentAt])
}

model ConversationAssignment {
  id             String @id @default(cuid())
  workspaceId    String
  conversationId String
  assignedTo     String?
  assignedBy     String
  createdAt      DateTime @default(now())
  conversation SocialConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Restrict)
  actor User @relation(fields: [workspaceId, assignedBy], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, conversationId, createdAt])
}

model ConversationTag {
  id             String @id @default(cuid())
  workspaceId    String
  conversationId String
  name           String
  conversation SocialConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([conversationId, name])
  @@index([workspaceId, name])
}

// Minimal normalized payload only; no raw tokens or unfiltered provider payloads.
model InboxEvent {
  id              String @id @default(cuid())
  workspaceId     String
  socialAccountId String
  eventKey        String
  source          String @default("MANUAL")
  payload         String
  payloadHash     String
  status          String @default("QUEUED")
  conversationId  String?
  createdBy       String
  createdAt       DateTime @default(now())
  processedAt     DateTime?
  account SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([workspaceId, eventKey])
  @@index([workspaceId, status])
}


// PHASE 6 — Paid account isolation. Never reuse/overwrite SocialProviderToken.
model AdAccount {
  id                  String @id @default(cuid())
  workspaceId         String
  brandId             String?
  provider            String
  providerAccountId   String
  displayName         String
  currency            String?
  timezone            String?
  providerTimezone    String?
  connectionStatus    String @default("UNVERIFIED")
  grantedScopes       String @default("[]")
  version             Int @default(1)
  lastValidatedAt     DateTime?
  lastAccountSyncAt   DateTime?
  lastCampaignSyncAt  DateTime?
  lastMetricsSyncAt   DateTime?
  lastConversionSyncAt DateTime?
  lastCatalogSyncAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  brand Brand? @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  credential AdAccountCredential?
  capabilitySnapshots AdProviderCapability[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, provider, providerAccountId])
  @@index([workspaceId, provider, connectionStatus])
}

// Tokens are encrypted with existing crypto helpers by a future verified OAuth flow only.
model AdAccountCredential {
  id              String @id @default(cuid())
  workspaceId     String
  adAccountId     String @unique
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  lastRotatedAt   DateTime @default(now())
  account AdAccount @relation(fields: [workspaceId, adAccountId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([workspaceId, adAccountId])
}

// Append-only capability evidence; no mutation/public import endpoint in this stage.
model AdProviderCapability {
  id           String @id @default(cuid())
  workspaceId  String
  adAccountId  String
  version      Int
  apiVersion   String?
  capabilities String @default("{}")
  source       String @default("UNVERIFIED")
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  account AdAccount @relation(fields: [workspaceId, adAccountId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([adAccountId, version])
  @@index([workspaceId, adAccountId, createdAt])
}

// Central product truth. No provider catalog or second commerce product model.
// --- Ürün Kataloğu (§100-§105) — 3eb kiracı izolasyonu + 0d6 AI katalog alanları birleşimi ---
model Product {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  name        String
  sku         String?
  category    String?
  description String   @default("")
  url         String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  brand     Brand     @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  facts     ProductFact[]
  claims    ProductClaim[]
  offers    CampaignOffer[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, sku])
  @@index([workspaceId, brandId, status])
  @@index([brandId])
}

model ProductVariant {
  id String @id @default(cuid())
  workspaceId String
  productId String
  sku String
  name String
  // Integer minor units; null means unknown, not free. Currency scale is stored.
  priceMinor Int?
  currency String
  currencyScale Int
  stock Int?
  version Int @default(1)
  source String @default("USER_PROVIDED")
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  inventory InventoryMovement[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, sku])
  @@index([workspaceId, productId])
}

model InventoryMovement {
  id String @id @default(cuid())
  workspaceId String
  variantId String
  fromStock Int?
  toStock Int
  reason String
  actorId String
  createdAt DateTime @default(now())
  variant ProductVariant @relation(fields: [workspaceId, variantId], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, variantId, createdAt])
}

model Contact {
  id String @id @default(cuid())
  workspaceId String
  brandId String
  name String
  email String?
  phone String?
  source String @default("USER_PROVIDED")
  status String @default("ACTIVE")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  brand Brand @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  leads Lead[]
  conversations ContactConversationLink[]
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, status])
}
model Lead {
  id String @id @default(cuid())
  workspaceId String
  contactId String
  campaignId String?
  ownerId String?
  title String
  stage String @default("NEW")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact Contact @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict)
  campaign Campaign? @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Restrict)
  owner User? @relation(fields: [workspaceId, ownerId], references: [workspaceId, id], onDelete: Restrict)
  activities LeadActivity[]
  @@unique([workspaceId, id])
  @@index([workspaceId, stage, updatedAt])
}
model LeadActivity {
  id String @id @default(cuid())
  workspaceId String
  leadId String
  actorId String
  type String
  text String
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, leadId, createdAt])
}
model ContactConversationLink {
  id String @id @default(cuid())
  workspaceId String
  contactId String
  conversationId String @unique
  actorId String
  createdAt DateTime @default(now())
  contact Contact @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict)
  conversation SocialConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([workspaceId, conversationId])
  @@index([workspaceId, contactId])
}


// =============================================================================
//  PHASE 4 — EXTENDED MODELS (§136): Product, Creative, AI, Automation, Trends
// =============================================================================

// --- Ürün Kataloğu (§100-§105) ---

model ProductMedia {
  id          String @id @default(cuid())
  workspaceId String
  brandId     String
  productId   String
  kind        String @default("IMAGE") // IMAGE | VIDEO
  storageKey  String?
  fileUrl     String?
  mediaAssetId String?
  width       Int?
  height      Int?
  bytesKb     Int?
  isPrimary   Boolean @default(false)
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([workspaceId])
}

model ProductFact {
  id          String @id @default(cuid())
  workspaceId String
  brandId     String
  productId   String
  key         String // PRICE | FEATURE | USAGE | SPEC ...
  value       String
  status      String @default("VERIFIED") // VERIFIED | UNVERIFIED | EXPIRED (§102)
  source      String?
  sourceId    String?
  verifiedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([workspaceId])
  @@index([status])
}

model ProductClaim {
  id          String @id @default(cuid())
  workspaceId String
  brandId     String
  productId   String?
  type        String @default("REQUIRED_DISCLAIMER") // REQUIRED_DISCLAIMER | FORBIDDEN_PHRASE | REQUIRED_PHRASE | REGULATED_CLAIM (§105)
  phrase      String
  required    Boolean @default(false)
  blocked     Boolean @default(false)
  approvalStatus String @default("APPROVED")
  createdAt   DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, brandId])
}

model CampaignOffer {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  productId   String?
  campaignId  String?
  name        String?
  price       Float?   // TRY
  currency    String   @default("TRY")
  discount    Float?   // %
  coupon      String?
  startDate   DateTime?
  endDate     DateTime?
  conditions  String?  // JSON or text
  status      String   @default("VERIFIED") // VERIFIED | UNVERIFIED | EXPIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, brandId])
  @@index([campaignId])
}

// --- AI / Kreatif (§56-§69, §107-§116) ---

model PromptTemplate {
  id           String   @id @default(cuid())
  workspaceId  String?
  name         String
  service      String   // e.g. captionGeneration, imageGeneration, creativeResize
  version      String   @default("1.0")
  systemPrompt String
  template     String   // handlebars-like
  outputSchema String   @default("{}") // JSON schema
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([service, isActive])
}

model AiUsage {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  brandId     String?
  provider    String   // deterministic | openai | anthropic
  service     String   // textGeneration | imageGeneration | imageEditing | videoProcessing | transcription | embeddings
  task        String?  // detail
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  imageCount  Int      @default(0)
  durationMs  Int      @default(0)
  costUSD     Float    @default(0)
  meta        String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([service])
}

model AiFeedback {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  brandId     String?
  contentId   String?
  service     String   // e.g. imageGeneration, captionGeneration
  outputId    String?  // reference to generated artifact
  rating      String   // LIKED | DISLIKED | BRAND_ALIGNED | BRAND_MISALIGNED
  note        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, brandId])
}

model AiImageGeneration {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?
  userId      String?
  prompt      String
  negativePrompt String?
  style       String?
  aspectRatio String?  // 1:1 | 4:5 | 9:16 | 16:9
  brandKitUsed Boolean @default(false)
  productId   String?
  status      String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELLED (Turkish: Kuyrukta etc. but stored English)
  resultUrl   String?
  resultKey   String?
  error       String?
  provider    String?
  costUSD     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, brandId])
  @@index([status])
}

model MasterCreative {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  title       String?
  storageKey  String   // master file
  fileUrl     String?
  width       Int?
  height      Int?
  aspectRatio String?
  layers      String   @default("{}") // JSON design state
  brandKitVersion Int?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants CreativeVariant[]
  quality  CreativeQualityScore?

  @@index([workspaceId, brandId])
}

model CreativeVariant {
  id               String @id @default(cuid())
  workspaceId      String
  brandId          String
  masterCreativeId String
  platform         String // INSTAGRAM | FACEBOOK | ...
  contentType      String // FEED | STORY | REEL ...
  aspectRatio      String
  width            Int?
  height           Int?
  storageKey       String?
  fileUrl          String?
  layers           String  @default("{}") // recomposed layers
  status           String  @default("READY")
  createdAt        DateTime @default(now())

  master MasterCreative @relation(fields: [masterCreativeId], references: [id], onDelete: Cascade)

  @@index([masterCreativeId])
  @@index([workspaceId])
}

model CreativeQualityScore {
  id               String @id @default(cuid())
  workspaceId      String
  brandId          String?
  masterCreativeId String @unique
  resolution       Int    @default(0) // 0-100
  readability      Int    @default(0)
  contrast         Int    @default(0)
  composition      Int    @default(0)
  brandConsistency Int    @default(0)
  platformFit      Int    @default(0)
  overall          Int    @default(0) // advisory
  details          String @default("{}") // JSON breakdown
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  master MasterCreative @relation(fields: [masterCreativeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// --- Otomasyon (§117-§124) ---
model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  trigger     String   // ContentCreated | ContentApproved | ...
  conditions  String   @default("[]") // JSON array
  actions     String   @default("[]") // JSON array
  enabled     Boolean  @default(false) // disabled by default (§122)
  autonomyLevel Int    @default(1) // 1-4
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions AutomationExecution[]

  @@index([workspaceId, enabled])
}

model AutomationExecution {
  id          String    @id @default(cuid())
  workspaceId String
  ruleId      String
  trigger     String
  triggerId   String?   // id of triggering entity
  status      String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | SKIPPED
  input       String    @default("{}") // JSON
  output      String?   // JSON
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([workspaceId, status])
}

// --- İçerik Planlama / Deneyler / Performans (§70-§93) ---
model ContentPlan {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  campaignId  String?
  title       String
  dateFrom    DateTime
  dateTo      DateTime
  goal        String?
  frequency   String? // e.g. 3x/week
  platforms   String   @default("[]") // JSON
  status      String   @default("DRAFT") // DRAFT | APPLIED | ARCHIVED
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ContentPlanItem[]

  @@index([workspaceId, brandId])
}

model ContentPlanItem {
  id            String    @id @default(cuid())
  workspaceId   String
  brandId       String
  planId        String
  date          DateTime
  platform      String
  contentType   String?
  topic         String?
  headline      String?
  captionConcept String?
  creativeConcept String?
  cta           String?
  hashtags      String    @default("[]") // JSON
  status        String    @default("PLANNED") // PLANNED | CREATED | PUBLISHED
  contentId     String?
  createdAt     DateTime  @default(now())

  plan ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, date])
  @@index([workspaceId])
  @@index([workspaceId, date])
}

model ContentExperiment {
  id          String    @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  hypothesis  String?
  variantA    String    // JSON
  variantB    String    // JSON
  metric      String    @default("ENGAGEMENT") // ENGAGEMENT | REACH | ...
  goal        String?
  startAt     DateTime?
  endAt       DateTime?
  status      String    @default("DRAFT") // DRAFT | RUNNING | DONE | CANCELLED
  winner      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model PerformancePrediction {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?
  contentId   String?
  platform    String
  format      String?
  publishAt   DateTime?
  inputs      String   @default("{}") // JSON inputs §91
  score       Float?   // 0-1 confidence
  label       String?  // "yüksek potansiyel"
  reason      String?
  confidence  String?  // LOW | MEDIUM | HIGH
  createdAt   DateTime @default(now())

  @@index([workspaceId, platform])
}

// --- Trend & Rakip (§94-§99) ---
model TrendItem {
  id          String   @id @default(cuid())
  workspaceId String?
  brandId     String?
  source      String   @default("DEMO") // DEMO | API | LICENSED
  title       String
  description String?
  platform    String?
  category    String?
  relevance   Float    @default(0) // 0-1
  freshness   Float    @default(0)
  opportunity String?
  data        String   @default("{}") // JSON raw
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([source])
}

model CompetitorProfile {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?  // which brand this competitor is compared to
  name        String
  handle      String?
  platform    String?
  website     String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contents CompetitorContent[]
  insights CompetitorInsight[]

  @@index([workspaceId])
}

model CompetitorContent {
  id          String   @id @default(cuid())
  workspaceId String
  competitorId String
  platform    String?
  externalId  String?
  caption     String?
  mediaUrl    String?
  publishedAt DateTime?
  metrics     String   @default("{}") // JSON likes/comments
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
}

model CompetitorInsight {
  id          String   @id @default(cuid())
  workspaceId String
  competitorId String
  type        String   // GAP | STRENGTH | OPPORTUNITY
  title       String
  description String?
  data        String   @default("{}")
  createdAt   DateTime @default(now())

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
}

// --- Semantik Arama / Embeddings (§128-§131) ---
model Embedding {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String   // CONTENT | MEDIA | PRODUCT | CAMPAIGN
  entityId    String
  text        String?  // source text
  vector      String   // JSON array (SQLite) — PG: vector type
  model       String   @default("demo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, entityType, entityId])
  @@index([workspaceId, entityType])
}

// --- Campaign relation extension for Product ---
// Note: Brand relation added via Product; CampaignOffer already links to campaignId
model AnalyticsAnomaly {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String?
  platform    String?
  metric      String
  date        DateTime
  expected    Float?
  actual      Float?
  deviation   Float?
  severity    String   @default("INFO")
  description String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, date])
}

// -----------------------------------------------------------------------------
// Çıkış ve Giriş Webhook Altyapısı (§78, §93)
// -----------------------------------------------------------------------------

model WebhookSubscription {
  id                  String   @id @default(cuid())
  workspaceId         String
  url                 String
  secret              String   // HMAC-SHA256 imzası için ortak gizli anahtar
  events              String   @default("[]") // JSON dizi: ["*"] veya ["content.published"]
  isActive            Boolean  @default(true)
  description         String?
  consecutiveFailures Int      @default(0)
  disabledAt          DateTime?
  disabledReason      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, isActive])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  workspaceId    String
  subscriptionId String
  event          String    // örn: content.published, inbox.event_received
  payload        String    // JSON gövdesi
  status         String    @default("PENDING") // PENDING | DELIVERED | RETRYING | DEAD_LETTER
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  responseStatus Int?
  responseBody   String?
  lastError      String?
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([subscriptionId, createdAt])
  @@index([status, nextRetryAt])
}

model InboundWebhookEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  provider    String    // META | X | LINKEDIN | GENERIC
  eventId     String    // Sağlayıcıdan gelen benzersiz event/delivery kimliği (dedupe key)
  eventType   String    // comment | mention | message | delivery_status | generic
  payloadHash String    // SHA-256 gövde özeti
  status      String    @default("PENDING") // PENDING | PROCESSED | DUPLICATE | FAILED
  rawPayload  String?   // Hassas veri içermeyen filtrelenmiş JSON
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
  @@index([workspaceId, status])
}

